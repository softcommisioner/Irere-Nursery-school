# Base URL for the Irere Nursery School backend API.
# Examples:
#   VITE_API_BASE_URL=http://localhost:4000/api
#   VITE_API_BASE_URL=https://<project-ref>.supabase.co/rest/v1
VITE_API_BASE_URL=/api

# Direct PostgreSQL connection string used by `npm run db:reset:demo`.
# For Supabase this is Project Settings -> Database -> Connection string (URI).
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase project URL + service role / secret key used by `npm run db:wipe:demo`.
# NEVER expose the service role key in Vite client code or commit it.
SUPABASE_URL=https://qediptcdjlmvznjhqweu.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Required only with `--include-auth-users`; comma-separated accounts to keep.
# ADMIN_EMAILS=admin@irerenursery.rw
