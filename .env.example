# ---------------------------------------------------------------------------
# Supabase (required for live data)
# ---------------------------------------------------------------------------
# Vite exposes VITE_* to the browser. Vercel/Next.js projects often use
# NEXT_PUBLIC_* instead - both names are supported by this app.
#
# Copy these values from Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://qediptcdjlmvznjhqweu.supabase.co

# Public anon / publishable key. This is safe to ship in the browser build as
# long as Row Level Security (RLS) is enabled on your tables.
VITE_SUPABASE_ANON_KEY=

# NEXT_PUBLIC_* equivalents (optional - use these on Vercel if preferred).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Admin / maintenance scripts only (NEVER expose these in client code)
# ---------------------------------------------------------------------------
# Direct PostgreSQL connection string used by `npm run db:reset:demo` and
# `npm run db:apply-schema` (creates every table + full read/write RLS
# policies; can also be pasted into the Supabase SQL Editor).
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase project URL + service role / secret key used by `npm run db:wipe:demo`.
SUPABASE_URL=https://qediptcdjlmvznjhqweu.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Required only with `--include-auth-users`; comma-separated accounts to keep.
# The Headmaster account is always preserved automatically.
# ADMIN_EMAILS=admin@irerenursery.rw

# ---------------------------------------------------------------------------
# Permanent Headmaster account (used by the app and provisioning script)
# ---------------------------------------------------------------------------
# The login identifier can be a phone number or an email address. A bare phone
# number is mapped to <digits>@irerenursery.rw because Supabase Auth requires
# an email. Override these values if the school changes its main account.
# HEADMASTER_PHONE=0788733564
# HEADMASTER_PASSWORD=irere@2026
# HEADMASTER_NAME=Headmaster
# SCHOOL_EMAIL_DOMAIN=irerenursery.rw

# Run `npm run db:provision:headmaster` once (with the service role key) to
# create or update the real Supabase Auth user for the Headmaster.
